<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AI Cover Letter Generator</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


<div class="container mt-5">


    <div class="text-center mb-5">

        <h1>✉️ AI Cover Letter Generator</h1>

        <p class="text-muted">
            Create a professional job-specific cover letter using AI.
        </p>

    </div>



    <div class="card shadow p-4">


        <form action="/cover-letter" method="POST">


            <div class="mb-3">

                <label class="form-label">
                    Your Name
                </label>

                <input 
                    type="text"
                    class="form-control"
                    name="name"
                    placeholder="Enter your name"
                    required>

            </div>



            <div class="mb-3">

                <label class="form-label">
                    Job Role
                </label>

                <input 
                    type="text"
                    class="form-control"
                    name="role"
                    placeholder="Software Developer Intern"
                    required>

            </div>



            <div class="mb-3">

                <label class="form-label">
                    Company Name
                </label>

                <input 
                    type="text"
                    class="form-control"
                    name="company"
                    placeholder="Company name"
                    required>

            </div>



            <div class="mb-3">

                <label class="form-label">
                    Skills
                </label>

                <textarea
                    class="form-control"
                    name="skills"
                    rows="4"
                    placeholder="Java, Python, HTML, CSS, JavaScript..."
                    required></textarea>

            </div>



            <div class="mb-3">

                <label class="form-label">
                    Additional Information
                </label>

                <textarea
                    class="form-control"
                    name="details"
                    rows="5"
                    placeholder="Projects, achievements, experience..."></textarea>

            </div>



            <button 
                type="submit"
                class="btn btn-primary w-100">

                Generate Cover Letter 🚀

            </button>


        </form>


    </div>


</div>


</body>

</html>
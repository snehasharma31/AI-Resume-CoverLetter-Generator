<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Generated Cover Letter</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


<div class="container mt-5">


    <div class="text-center mb-4">

        <h1>✉️ Generated Cover Letter</h1>

        <p class="text-muted">
            AI-generated professional cover letter
        </p>

    </div>



    <div class="card shadow p-5">


        <h4>
            Dear Hiring Manager,
        </h4>


        <p>
            I am excited to apply for the 
            <strong><%= role %></strong>
            position at
            <strong><%= company %></strong>.
        </p>


        <p>
            I am a motivated candidate with skills in
            <strong><%= skills %></strong>.
            I believe my technical knowledge and problem-solving abilities
            make me a suitable candidate for this opportunity.
        </p>


        <p>
            During my academic journey, I have worked on projects and
            continuously improved my development skills.
            <%= details %>
        </p>


        <p>
            I would appreciate the opportunity to contribute my skills
            and learn from your organization.
            Thank you for considering my application.
        </p>



        <br>


        <p>
            Regards,
            <br>
            <strong><%= name %></strong>
        </p>


    </div>



    <div class="text-center mt-4">

        <a href="/cover-letter" class="btn btn-primary">
            Create Another Cover Letter
        </a>

        <a href="/" class="btn btn-secondary">
            Home
        </a>

    </div>


</div>


</body>

</html>